{
  "name": "dbk-stage-control",
  "private": true,
  "version": "1.0.0",
  "description": "Live-performance playback, notation, lyrics, setlist, and stage control",
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/core",
    "packages/audio",
    "packages/protocol",
    "packages/logger",
    "host"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run build -w @dbk/web",
    "pages:build": "VITE_PUBLIC_CLIENT=1 npm run build -w @dbk/web",
    "build:ios": "npm run build:ios -w @dbk/web && npx cap sync ios",
    "ios": "npm run build:ios",
    "ios:open": "npx cap open ios",
    "fixtures": "node scripts/generate-fixtures.mjs",
    "publish:library": "npx tsx scripts/publish-client-library.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@types/node": "^24.3.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.5.1",
    "capacitor-websocket-server": "^0.0.1"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
